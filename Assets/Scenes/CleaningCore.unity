  speciesNames:
  - "\u0422\u0415\u0420\u041E\u041F\u041E\u0414"
  - "\u0426\u0415\u0420\u0410\u0422\u041E\u041F\u0421"
  - "\u0417\u0410\u0423\u0420\u041E\u041F\u041E\u0414"
  speciesDescriptions:
  - "\u0423\u0437\u043A\u0430\u044F \u0438 \u043B\u0451\u0433\u043A\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
    \u043F\u043B\u0430\u0432\u043D\u044B\u0439 \u0438\u0437\u0433\u0438\u0431, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435
    \u0441\u0443\u0441\u0442\u0430\u0432\u044B. \u041F\u043E\u0440\u043E\u0434\u0430:
    \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A."
  - "\u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F \u0438 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C, \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043A\u043E\u043D\u0446\u044B.
    \u041F\u043E\u0440\u043E\u0434\u0430: \u0433\u043B\u0438\u043D\u0430."
  - "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0438 \u043A\u0440\u0443\u043F\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C, \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u044B.
    \u041F\u043E\u0440\u043E\u0434\u0430: \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044F\u043A.
    \u041D\u0443\u0436\u043D\u043E \u0437\u0443\u0431\u0438\u043B\u043E."
  boneSpecies: 000000000100000002000000
  tools:
  - kind: 0
